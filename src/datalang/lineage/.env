# YugabyteDB connection
YB_HOST=127.0.0.1
YB_PORT=5433
YB_DATABASE=northwind
YB_USER=yugabyte
YB_PASSWORD="yugabyte"

# Debezium connector
CONNECTOR_NAME=yugabyte-cdc
CONNECTOR_CLASS=io.debezium.connector.postgresql.YugabyteDBConnector
CONNECTOR_TASKS_MAX=1
CDC_CONNECTOR=quay.io/yugabyte/ybdb-debezium:dz.2.5.2.yb.2026.1.2.0.1

# CDC settings
CDC_TOPIC_PREFIX=yb_test
CDC_PLUGIN_NAME=yboutput
CDC_SLOT_NAME=yb_test_slot
CDC_PUBLICATION_NAME=yb_test_publication
CDC_PUBLICATION_AUTOCREATE_MODE=filtered
CDC_SNAPSHOT_MODE=initial

# Table selection
CDC_SCHEMA_INCLUDE_LIST=public
CDC_TABLE_INCLUDE_LIST=public.categories,public.customer_customer_demo,public.customer_demographics,public.customers,public.employee_territories,public.employees,public.order_details,public.orders,public.products,public.region,public.shippers,public.suppliers,public.territories,public.us_states

# Kafka Connect REST API
CONNECT_URL=http://localhost:8083
