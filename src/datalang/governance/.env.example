# Note that this is for checking if connector registation is working
# when u set up Kafka

# PostSQL DB connection
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=northwind
DB_USER=debezium_user
DB_PASSWORD=debezium

# Debezium connector
CONNECTOR_NAME=postgres-cdc
CONNECTOR_CLASS=io.debezium.connector.postgresql.PostgresConnector
CONNECTOR_TASKS_MAX=1
CDC_CONNECTOR=quay.io/debezium/connect:2.7.3.Final

# CDC settings
CDC_TOPIC_PREFIX=db_test
CDC_PLUGIN_NAME=pgoutput
CDC_SLOT_NAME=db_test_slot
CDC_PUBLICATION_NAME=db_test_publication
CDC_PUBLICATION_AUTOCREATE_MODE=disabled
CDC_SNAPSHOT_MODE=initial

# Table selection
CDC_SCHEMA_INCLUDE_LIST=public
CDC_TABLE_INCLUDE_LIST=public.categories,public.customer_customer_demo,public.customer_demographics,public.customers,public.employee_territories,public.employees,public.order_details,public.orders,public.products,public.region,public.shippers,public.suppliers,public.territories,public.us_states

# Kafka Connect REST API
CONNECT_URL=http://localhost:8083
